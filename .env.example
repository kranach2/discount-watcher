# Copy this file to .env and fill in real values. Never commit .env to git.

# Your Anthropic API key — get one at https://console.anthropic.com/
# This is what pays for each daily run. A typical run is well under 1 cent.
ANTHROPIC_API_KEY=sk-ant-...

# Gmail credentials for sending the digest.
# IMPORTANT: GMAIL_APP_PASSWORD is NOT your normal Gmail password. It is a
# 16-character app password. Get one at https://myaccount.google.com/apppasswords
# (you need 2-step verification enabled on your Google account first).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where the daily digest is sent. Usually the same as GMAIL_USER, but can be
# different (e.g. you send from a dedicated address to your main inbox).
EMAIL_TO=you@gmail.com
